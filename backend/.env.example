DATABASE_URL="postgresql://lexpsique:lexpsique@localhost:5432/lexpsique?schema=public"
PORT=3000

# Secret used to derive the AES-256-GCM key for encrypting sensitive fields
# at rest (via SHA-256) — any high-entropy string works, doesn't need to be
# literal base64. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY_BASE64=""

# Optional: enables Claude-assisted classification/personalization.
# Never required for the deterministic MVP flow — heuristic classifier and
# placeholder substitution work standalone.
ANTHROPIC_API_KEY=""

# Secret for signing session auth tokens (JWT). Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=""

# Minimal shared-secret guard for template-approval admin endpoints in the
# MVP. Not a real admin auth system — see docs/architecture.md follow-ups.
ADMIN_API_KEY=""

# Comma-separated list of allowed frontend origins for CORS. Empty means
# "allow any origin" — fine for local development, must be set explicitly
# before any real deployment.
CORS_ORIGINS=""

# Faturação (Stripe) — todos opcionais. Sem STRIPE_SECRET_KEY, a app
# funciona normalmente e só a subscrição fica indisponível (503). Ver
# docs/interno/preco-e-nome.md e o guia de configuração da conta Stripe.
FRONTEND_URL="http://localhost:5173"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PT_MONTHLY=""
STRIPE_PRICE_PT_ANNUAL=""
STRIPE_PRICE_BR_MONTHLY=""
STRIPE_PRICE_BR_ANNUAL=""
